[Unit]
Description=Manage dotfiles for user %I
After=network.target

[Service]
Type=oneshot
User=%i
# systemd never runs two instances of one unit at once, so a scheduled run and
# the one chezmoi-sync triggers cannot collide, and no lock is wanted here. Do
# not reintroduce one under /var/lock: that path is root-owned, and locking
# there stops this unit from starting at all as the unprivileged user.
ExecStart=/usr/local/bin/chezmoi update

# Hardening
ProtectSystem=full
PrivateTmp=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
