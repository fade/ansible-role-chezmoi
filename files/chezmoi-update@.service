[Unit]
Description=Manage dotfiles for user %I
After=network.target

[Service]
Type=oneshot
User=%i
# flock serializes against a manual `chezmoi update` run directly in a shell.
# A scheduled run and a `systemctl start chezmoi-update@%i.service` (what the
# chezmoi-sync wrapper issues) are already serialized by systemd, which never
# runs two instances of one unit at once; the lock covers the raw-CLI case too.
# /var/lock survives PrivateTmp and is writable by the unprivileged user.
ExecStart=/usr/bin/flock --wait 600 /var/lock/chezmoi-update-%i.lock /usr/local/bin/chezmoi update

# Hardening
ProtectSystem=full
PrivateTmp=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
